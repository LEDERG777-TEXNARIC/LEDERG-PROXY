[
  {
    "remarks": "LEDERG Home HTTP Proxy",
    "meta": {
      "serverDescription": "Cloudpub TCP 10412"
    },
    "dns": {
      "servers": [
        "77.88.8.8",
        "77.88.8.1"
      ],
      "queryStrategy": "UseIP"
    },
    "inbounds": [
      {
        "tag": "socks-in",
        "listen": "127.0.0.1",
        "port": 10808,
        "protocol": "socks",
        "settings": {
          "auth": "noauth",
          "udp": true
        },
        "sniffing": {
          "enabled": true,
          "destOverride": [
            "http",
            "tls",
            "quic"
          ]
        }
      }
    ],
    "outbounds": [
      {
        "tag": "proxy",
        "protocol": "http",
        "settings": {
          "servers": [
            {
              "address": "tcp.cloudpub.ru",
              "port": 10412
            }
          ]
        }
      }
    ],
    "routing": {
      "domainStrategy": "AsIs",
      "rules": []
    }
  }
]
