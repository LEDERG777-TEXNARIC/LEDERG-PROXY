[
  {
    "remarks": "LEDERG Home SOCKS Proxy",
    "meta": {
      "serverDescription": "Cloudpub TCP 15227"
    },
    "inbounds": [
      {
        "tag": "socks-in",
        "listen": "127.0.0.1",
        "port": 10808,
        "protocol": "socks",
        "settings": {
          "auth": "noauth",
          "udp": true
        }
      }
    ],
    "outbounds": [
      {
        "tag": "proxy",
        "protocol": "socks",
        "settings": {
          "servers": [
            {
              "address": "tcp.cloudpub.ru",
              "port": 15227
            }
          ]
        }
      }
    ],
    "routing": {
      "domainStrategy": "AsIs",
      "rules": []
    }
  }
]
